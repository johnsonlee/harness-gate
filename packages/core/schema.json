{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "modules", "checks"],
  "properties": {
    "version": { "const": 1 },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "stack"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$" },
          "path": { "type": "string", "minLength": 1 },
          "stack": {
            "enum": [
              "android",
              "ios",
              "java",
              "node",
              "react",
              "next",
              "bun",
              "vue"
            ]
          },
          "dependencies": { "$ref": "#/$defs/strings" },
          "allowedDependencies": { "$ref": "#/$defs/strings" }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "modules", "phase", "command"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "modules": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "phase": { "enum": ["static", "verify"] },
          "command": {
            "type": "array",
            "minItems": 1,
            "prefixItems": [{ "type": "string", "minLength": 1 }],
            "items": { "type": "string" }
          },
          "cwd": { "type": "string", "minLength": 1 },
          "timeoutMs": { "type": "integer", "minimum": 1 },
          "required": { "type": "boolean" },
          "output": { "enum": ["text", "harness-json-v1"] }
        }
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "file", "provider", "consumers", "command"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "minLength": 1 },
          "provider": { "type": "string", "minLength": 1 },
          "consumers": { "$ref": "#/$defs/strings" },
          "command": {
            "type": "array",
            "minItems": 1,
            "prefixItems": [{ "type": "string", "minLength": 1 }],
            "items": { "type": "string" }
          }
        }
      }
    }
  },
  "$defs": {
    "strings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
